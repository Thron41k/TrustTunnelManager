{
  "ConnectionStrings": {
    "ApplicationDatabase": "Data Source=App_Data/trusttunnelmanager.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "KnownProxies": [
      "127.0.0.1",
      "::1"
    ]
  },
  "TrustTunnelManager": {
    "BootstrapAdmin": {
      "Username": "",
      "Password": ""
    }
  },
  "TrustTunnel": {
    "Paths": {
      "SettingsFile": "/opt/trusttunnel/vpn.toml",
      "TlsHostsFile": "/opt/trusttunnel/hosts.toml",
      "ExecutablePath": "/opt/trusttunnel/trusttunnel_endpoint"
    },
    "Service": {
      "UnitName": "trusttunnel.service",
      "UseSudo": true,
      "UseSudoForJournalctl": false,
      "SudoPath": "/usr/bin/sudo",
      "SystemctlPath": "/usr/bin/systemctl",
      "JournalctlPath": "/usr/bin/journalctl",
      "CommandTimeoutSeconds": 15
    },
    "ClientConfiguration": {
      "Addresses": [],
      "DisplayName": "TrustTunnel",
      "DnsUpstreams": [],
      "CommandTimeoutSeconds": 30
    },
    "Metrics": {
      "BaseAddress": "http://127.0.0.1:1987/",
      "TimeoutSeconds": 3
    }
  }
}
