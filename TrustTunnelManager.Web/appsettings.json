{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Admin": {
    "Username": "",
    "Password": ""
  },
  "Mesh": {
    "NodeName": "",
    "AdvertisedBaseUrl": "https://127.0.0.1:5080",
    "IdentityCertificatePath": "/etc/trusttunnelmanager/node-identity.pfx",
    "IdentityCertificatePassword": "",
    "StateDirectory": "/var/lib/trusttunnelmanager"
  },
  "TrustTunnelClient": {
    "ServiceUnit": "trusttunnel-client.service",
    "ConfigurationFile": "/etc/trusttunnel/client.toml",
    "NetworkInterface": "",
    "UseSudo": true,
    "UseSudoForJournalctl": true,
    "SudoPath": "/usr/bin/sudo",
    "SystemctlPath": "/usr/bin/systemctl",
    "JournalctlPath": "/usr/bin/journalctl",
    "CommandTimeoutSeconds": 15
  },
  "Watchdog": {
    "Enabled": true,
    "Interface": "tun0",
    "ProbeUrl": "https://www.cloudflare.com/cdn-cgi/trace",
    "CurlPath": "/usr/bin/curl",
    "InitialDelaySeconds": 120,
    "IntervalSeconds": 60,
    "FailureThreshold": 3,
    "RestartCooldownSeconds": 300,
    "ConnectTimeoutSeconds": 5,
    "MaxTimeSeconds": 12
  }
}
