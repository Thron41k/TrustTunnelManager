@page "/"
@implements IAsyncDisposable
@inject ITrustTunnelMonitoringService MonitoringService
@inject ILogger<Home> Logger

<PageTitle>Обзор сервера — TrustTunnel Manager</PageTitle>

<div class="dashboard-page">
    <header class="dashboard-header">
        <div>
            <div class="eyebrow">TRUSTTUNNEL ENDPOINT</div>
            <h1>Обзор сервера</h1>
            <p class="page-description">Состояние VPN endpoint и статистика подключений</p>
        </div>

        <div class="header-actions">
            <div class="connection-status">
                <span class="status-indicator @StatusClass"></span>
                <span>@StatusText</span>
            </div>

            <button class="refresh-button"
                    @onclick="RefreshAsync"
                    disabled="@_isRefreshing">
                <span class="@(_isRefreshing ? "refresh-symbol is-spinning" : "refresh-symbol")">↻</span>
                Обновить
            </button>
        </div>
    </header>

    @if (_snapshot is null)
    {
        <section class="dashboard-message">
            <div class="loading-indicator"></div>
            <div>
                <strong>Подключение к TrustTunnel</strong>
                <p>Получаем состояние сервера и метрики...</p>
            </div>
        </section>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_snapshot.ErrorMessage))
        {
            <div class="notice notice-error" role="alert">
                <strong>Нет данных мониторинга</strong>
                <span>@_snapshot.ErrorMessage</span>
                <span class="notice-hint">Проверьте, что TrustTunnel запущен и Metrics API доступен по адресу, указанному в appsettings.json.</span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_snapshot.WarningMessage))
        {
            <div class="notice notice-warning" role="status">
                @_snapshot.WarningMessage
            </div>
        }

        <section class="metrics-grid" aria-label="Основные показатели">
            <article class="metric-card">
                <div class="metric-card-heading">
                    <span class="metric-icon icon-sessions">↔</span>
                    <span>Активные сессии</span>
                </div>
                <div class="metric-value">@FormatNumber(_snapshot.ActiveSessions)</div>
                <div class="metric-caption">Подключения клиентов</div>
            </article>

            <article class="metric-card">
                <div class="metric-card-heading">
                    <span class="metric-icon icon-download">↓</span>
                    <span>Получено сервером</span>
                </div>
                <div class="metric-value">@FormatBytes(_snapshot.InboundTrafficBytes)</div>
                <div class="metric-caption">Входящий трафик, с момента запуска</div>
            </article>

            <article class="metric-card">
                <div class="metric-card-heading">
                    <span class="metric-icon icon-upload">↑</span>
                    <span>Передано клиентам</span>
                </div>
                <div class="metric-value">@FormatBytes(_snapshot.OutboundTrafficBytes)</div>
                <div class="metric-caption">Исходящий трафик, с момента запуска</div>
            </article>

            <article class="metric-card">
                <div class="metric-card-heading">
                    <span class="metric-icon icon-network">⇄</span>
                    <span>Исходящие сокеты</span>
                </div>
                <div class="metric-value">@FormatNumber(_snapshot.OutboundTcpSockets + _snapshot.OutboundUdpSockets)</div>
                <div class="metric-caption">TCP: @FormatNumber(_snapshot.OutboundTcpSockets) · UDP: @FormatNumber(_snapshot.OutboundUdpSockets)</div>
            </article>
        </section>

        <section class="dashboard-columns">
            <article class="panel protocol-panel">
                <div class="panel-heading">
                    <div>
                        <h2>Протоколы подключений</h2>
                        <p>Активные клиентские сессии</p>
                    </div>
                </div>

                @if (_snapshot.SessionsByProtocol.Count == 0)
                {
                    <div class="empty-state">Нет активных сессий</div>
                }
                else
                {
                    <div class="protocol-list">
                        @foreach (var protocol in _snapshot.SessionsByProtocol.OrderByDescending(x => x.Value))
                        {
                            var percentage = _snapshot.ActiveSessions == 0
                                ? 0
                                : (int)Math.Round(protocol.Value * 100d / _snapshot.ActiveSessions);

                            <div class="protocol-row" @key="protocol.Key">
                                <div class="protocol-label">
                                    <strong>@protocol.Key</strong>
                                    <span>@FormatNumber(protocol.Value)</span>
                                </div>
                                <div class="protocol-track">
                                    <div class="protocol-fill" style="width: @percentage%"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </article>

            <article class="panel endpoint-panel">
                <div class="panel-heading">
                    <div>
                        <h2>Состояние endpoint</h2>
                        <p>Последняя проверка Metrics API</p>
                    </div>
                </div>

                <div class="endpoint-state">
                    <span class="status-indicator @StatusClass"></span>
                    <strong>@StatusText</strong>
                </div>
                <dl class="endpoint-details">
                    <div>
                        <dt>Последнее обновление</dt>
                        <dd>@_snapshot.CollectedAtUtc.ToLocalTime().ToString("HH:mm:ss")</dd>
                    </div>
                    <div>
                        <dt>TCP-сокеты</dt>
                        <dd>@FormatNumber(_snapshot.OutboundTcpSockets)</dd>
                    </div>
                    <div>
                        <dt>UDP-сокеты</dt>
                        <dd>@FormatNumber(_snapshot.OutboundUdpSockets)</dd>
                    </div>
                </dl>
            </article>
        </section>

        <section class="panel clients-panel">
            <div class="panel-heading clients-heading">
                <div>
                    <h2>Пользователи</h2>
                    <p>Статистика, предоставленная TrustTunnel endpoint</p>
                </div>
                @if (_snapshot.PerClientMetricsEnabled)
                {
                    <span class="count-badge">@_snapshot.Clients.Count</span>
                }
            </div>

            @if (!_snapshot.PerClientMetricsEnabled)
            {
                <div class="empty-state clients-disabled">
                    <strong>Персональная статистика отключена</strong>
                    <p>Чтобы видеть пользователей, IP-адреса и их трафик, включите <code>per_client_metrics = true</code> в секции <code>[metrics]</code> файла vpn.toml.</p>
                </div>
            }
            else if (_snapshot.Clients.Count == 0)
            {
                <div class="empty-state">TrustTunnel пока не вернул список пользователей</div>
            }
            else
            {
                <div class="table-scroll">
                    <table class="clients-table">
                        <thead>
                            <tr>
                                <th>Пользователь</th>
                                <th>IP-адрес</th>
                                <th>Сессии</th>
                                <th>Получено</th>
                                <th>Передано</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var client in _snapshot.Clients)
                            {
                                <tr @key="client.Username">
                                    <td class="username-cell">@client.Username</td>
                                    <td class="ip-cell">@(client.IpAddress ?? "—")</td>
                                    <td>@FormatNumber(client.ActiveSessions)</td>
                                    <td>@FormatBytes(client.InboundTrafficBytes)</td>
                                    <td>@FormatBytes(client.OutboundTrafficBytes)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <footer class="dashboard-footer">
            Автоматическое обновление каждые 10 секунд
            <span>·</span>
            Время последнего сбора: @_snapshot.CollectedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")
        </footer>
    }
</div>

@code {
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(10);

    private TrustTunnelDashboardSnapshot? _snapshot;
    private CancellationTokenSource? _refreshCancellation;
    private Task _refreshTask = Task.CompletedTask;
    private bool _isRefreshing;

    private string StatusClass => _snapshot?.IsOnline == true ? "is-online" : "is-offline";

    private string StatusText => _snapshot is null
        ? "Проверка..."
        : _snapshot.IsOnline ? "Работает" : "Недоступен";

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();

        _refreshCancellation = new CancellationTokenSource();
        _refreshTask = RunRefreshLoopAsync(_refreshCancellation.Token);
    }

    private async Task RefreshAsync()
    {
        if (_isRefreshing)
        {
            return;
        }

        _isRefreshing = true;

        try
        {
            _snapshot = await MonitoringService.GetSnapshotAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to refresh TrustTunnel dashboard.");
            _snapshot = TrustTunnelDashboardSnapshot.Offline(
                DateTimeOffset.UtcNow,
                "Не удалось получить данные мониторинга. Подробности доступны в журнале приложения.");
        }
        finally
        {
            _isRefreshing = false;
        }
    }

    private async Task RunRefreshLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(RefreshInterval);

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // The component was disposed.
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "TrustTunnel dashboard refresh loop stopped unexpectedly.");
        }
    }

    private static string FormatNumber(long value) =>
        value.ToString("N0", System.Globalization.CultureInfo.CurrentCulture);

    private static string FormatBytes(long bytes)
    {
        if (bytes < 0)
        {
            return "—";
        }

        string[] units = ["Б", "КБ", "МБ", "ГБ", "ТБ"];
        var size = (double)bytes;
        var unitIndex = 0;

        while (size >= 1024 && unitIndex < units.Length - 1)
        {
            size /= 1024;
            unitIndex++;
        }

        return unitIndex == 0
            ? $"{size:N0} {units[unitIndex]}"
            : $"{size:N2} {units[unitIndex]}";
    }

    public async ValueTask DisposeAsync()
    {
        if (_refreshCancellation is null)
        {
            return;
        }

        await _refreshCancellation.CancelAsync();

        try
        {
            await _refreshTask;
        }
        catch (OperationCanceledException)
        {
            // Expected when the component is disposed.
        }
        finally
        {
            _refreshCancellation.Dispose();
        }
    }
}
