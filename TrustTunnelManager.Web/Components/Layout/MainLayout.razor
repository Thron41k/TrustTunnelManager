@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="app-shell">
    <aside class="app-sidebar">
        <a class="brand" href="/">
            <span class="brand-mark">TT</span>
            <span>
                <strong>TrustTunnel</strong>
                <small>MANAGER</small>
            </span>
        </a>

        <div class="sidebar-label">МОНИТОРИНГ</div>
        <nav class="sidebar-nav">
            <NavLink href="/" Match="NavLinkMatch.All">
                <span class="nav-icon">▦</span>
                Обзор
            </NavLink>
            <NavLink href="/clients">
                <span class="nav-icon">◉</span>
                Пользователи
            </NavLink>
            <NavLink href="/rules">
                <span class="nav-icon">⌁</span>
                Правила доступа
            </NavLink>
        </nav>

        <div class="sidebar-label">УПРАВЛЕНИЕ</div>
        <nav class="sidebar-nav">
            <NavLink href="/service">
                <span class="nav-icon">◈</span>
                Служба и журналы
            </NavLink>
            <NavLink href="/audit">
                <span class="nav-icon">≡</span>
                Аудит действий
            </NavLink>
        </nav>

        <div class="sidebar-bottom">
            <div class="node-label">ЛОКАЛЬНЫЙ УЗЕЛ</div>
            <div class="node-status"><span></span> TrustTunnel endpoint</div>
        </div>
    </aside>

    <div class="app-main">
        <header class="app-topbar">
            <div class="topbar-title">Панель управления</div>
            <AuthorizeView>
                <Authorized Context="auth">
                    <div class="topbar-user">
                        <span class="user-avatar">@GetInitial(auth.User.Identity?.Name)</span>
                        <span class="user-name">@auth.User.Identity?.Name</span>
                        <button type="button" class="logout-button" @onclick="LogoutAsync">Выйти</button>
                    </div>
                </Authorized>
            </AuthorizeView>
        </header>

        <main class="app-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Произошла ошибка приложения.
    <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss">×</span>
</div>

@code {
    private async Task LogoutAsync()
    {
        await JS.InvokeVoidAsync("trustTunnelManager.logout");
    }

    private static string GetInitial(string? username) =>
        string.IsNullOrWhiteSpace(username) ? "A" : username[..1].ToUpperInvariant();
}
